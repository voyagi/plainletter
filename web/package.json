{
  "name": "@plainletter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desk console and public landing page for Plainletter",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gate:deps": "depcruise src --config .dependency-cruiser.cjs",
    "gate:size": "size-limit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1113.0",
    "@t3-oss/env-core": "^0.13.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-sonarjs": "^4.0.0",
    "jsdom": "^30.0.0",
    "schema-dts": "^2.0.0",
    "size-limit": "^13.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
