{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteWithTheEuropeanInferenceProfiles",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:eu-central-1:*:inference-profile/eu.anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:eu-central-1:*:inference-profile/eu.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:eu-*::foundation-model/anthropic.claude-sonnet-4-6",
        "arn:aws:bedrock:eu-*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    {
      "Sid": "KeepAndRecallConsentedCaseRecords",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateEvent",
        "bedrock-agentcore:ListEvents",
        "bedrock-agentcore:GetEvent"
      ],
      "Resource": "arn:aws:bedrock-agentcore:eu-central-1:*:memory/*"
    }
  ]
}
