# Normalize text to LF in the repository regardless of the checkout platform, so the gates and
# generated files are byte-identical on Windows, macOS and CI.
* text=auto eol=lf

# Binary samples and images
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary

# Calendar files end their lines in CRLF by the iCalendar standard (RFC 5545), so the captured
# reminders under examples/ keep the bytes the agent sent.
*.ics -text
