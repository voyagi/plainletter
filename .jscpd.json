{
  "minTokens": 70,
  "minLines": 8,
  "threshold": 0,
  "reporters": ["console-full"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/package-lock.json",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/.wrangler/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "**/*.md",
    "**/docs/**",
    "design/**",
    "tests/fixtures/**"
  ]
}
