# Copy to .env and fill in. Credentials never live here: AWS credentials come from `aws login`
# or an AWS profile on the machine, and the console proxy reads them from its own host.

# AWS. The agent reads PLAINLETTER_REGION first, then AWS_REGION.
AWS_REGION=eu-central-1
AWS_PROFILE=default

# Bedrock model IDs (EU geo inference profiles, Frankfurt as source region). Drafting runs on the
# reading model as well. It is a separate setting so that can be revisited.
PLAINLETTER_READING_MODEL=eu.anthropic.claude-sonnet-4-6
PLAINLETTER_DRAFTING_MODEL=eu.anthropic.claude-sonnet-4-6

# AgentCore Memory store id for consented cases. Empty means the agent keeps nothing, and says so
# when a visitor consents. A deployed runtime gets MEMORY_PLAINLETTERMEMORY_ID from the deployment
# instead and needs no value here.
PLAINLETTER_MEMORY_ID=

# Readings a day, per runtime, refused before the first model call. Zero closes the reading service
# without taking the deployment down.
PLAINLETTER_MAX_READINGS_PER_DAY=200

# The console. With the runtime ARN set, the proxy signs calls to the deployed agent. Without it,
# the console posts to the endpoint, which is the agent started locally.
PLAINLETTER_AGENT_ENDPOINT=http://127.0.0.1:8080
PLAINLETTER_AGENT_RUNTIME_ARN=

# Who answers for the data at THIS desk, shown on the privacy page. A library running its own copy
# is its own controller, so these are deployment facts and never hard-coded. Left empty, the page
# says the organisation running the desk is the controller and tells the visitor to ask at the
# counter, which is true everywhere. Article 13(1)(a) wants the real name and a contact address, so
# fill them before serving anybody. Both or neither: the console refuses to start on half a pair,
# because a name nobody can write to is not a disclosure.
PLAINLETTER_CONTROLLER_NAME=
PLAINLETTER_CONTROLLER_CONTACT=

# The data protection officer's contact address, where one exists. Article 37 makes an officer
# compulsory for a public authority or body, excepting a court acting in its judicial capacity, and
# Article 37(7) makes publishing the contact details compulsory too, so a municipality or another
# public body inside that scope MUST fill this in. An EMAIL ADDRESS and validated as one, because
# the page turns it into a link: a phone number here would render as a link that goes nowhere.
# Left empty the page says this desk publishes no officer and sends questions to the controller,
# which describes the configuration and establishes nothing about your own Article 37 position.
PLAINLETTER_DPO_CONTACT=

# Set to true only when a proxy really sits in front of the console and appends the caller to
# X-Forwarded-For, which is the case on Vercel and on most managed hosts. Left false, every caller
# is rate limited as one, which is stricter rather than looser.
PLAINLETTER_TRUST_PROXY_HEADER=false
