# Copy to .env and fill in. Credentials never live here: AWS credentials come from `aws login`
# or an AWS profile on the machine, and the console proxy reads them from its own host.

# AWS. The agent reads PLAINLETTER_REGION first, then AWS_REGION.
AWS_REGION=eu-central-1
AWS_PROFILE=default

# Bedrock model IDs (EU geo inference profiles, Frankfurt as source region). Drafting runs on the
# reading model as well. It is a separate setting so that can be revisited.
PLAINLETTER_READING_MODEL=eu.anthropic.claude-sonnet-4-6
PLAINLETTER_DRAFTING_MODEL=eu.anthropic.claude-sonnet-4-6

# AgentCore Memory store id for consented cases. Empty means the agent keeps nothing, and says so
# when a visitor consents. A deployed runtime gets MEMORY_PLAINLETTERMEMORY_ID from the deployment
# instead and needs no value here.
PLAINLETTER_MEMORY_ID=

# The console. With the runtime ARN set, the proxy signs calls to the deployed agent. Without it,
# the console posts to the endpoint, which is the agent started locally.
PLAINLETTER_AGENT_ENDPOINT=http://127.0.0.1:8080
PLAINLETTER_AGENT_RUNTIME_ARN=
