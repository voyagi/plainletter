# Copy to .env and fill in. Credentials never live here: AWS credentials come from `aws login`
# or an AWS profile on the machine, and the console proxy reads them from its own host.

# AWS
AWS_REGION=eu-central-1
AWS_PROFILE=default

# Bedrock model IDs (EU geo inference profiles, Frankfurt as source region)
PLAINLETTER_READER_MODEL=eu.anthropic.claude-sonnet-4-6
PLAINLETTER_FAST_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# AgentCore Memory store id. Empty means the agent runs without memory (the default).
PLAINLETTER_MEMORY_ID=

# Local agent server
PLAINLETTER_HOST=127.0.0.1
PLAINLETTER_PORT=8080
